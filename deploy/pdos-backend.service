[Unit]
Description=PDOS Backend (FastAPI + Uvicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
User=pdos
Group=pdos
WorkingDirectory=/opt/pdos/backend
Environment=PATH=/opt/pdos/backend/venv/bin
EnvironmentFile=/opt/pdos/backend/.env
ExecStart=/opt/pdos/backend/venv/bin/uvicorn main:app \
  --host 127.0.0.1 \
  --port 8000 \
  --workers 4 \
  --log-level info \
  --proxy-headers \
  --forwarded-allow-ips="127.0.0.1"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
