# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL="sqlite:///./pdos.db"
REDIS_URL=""
FIREBASE_CREDENTIALS_PATH=""
NVIDIA_API_KEY="nvapi-your-key-here"

# ── Server (docker compose) — install.sh generates these automatically ──
# DB_PASSWORD: hex only (it is embedded in DATABASE_URL). openssl rand -hex 24
DB_PASSWORD=
CORS_ORIGINS=*
UVICORN_WORKERS=4
LOG_LEVEL=info
FCM_SERVICE_ACCOUNT_JSON=
